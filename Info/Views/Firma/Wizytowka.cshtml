@model Info.Models.Firma

@{
    ViewData["Title"] = "Wizytówka";
}

<h1>Wizytówka firmy CompuMedia</h1>

<div class="alert alert-dark fw-semibold" role="alert">
    <p>@Model.PelnaNazwa</p>
