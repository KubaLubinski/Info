@using System.Security.Policy
@model TextsViewModel
@{
    ViewData["Title"] = "Lista tekstów";
}

<div class="container">
    <div class="row">
        <!--wyszukiwarka-->
        <div class="d-none d-md-block col-md-12 col-xl-3">
            <div class="card mb-2">
                <div class="card-body">
                    Wyszukiwarka
                </div>
            </div>
        </div>


        <!--lista tekstow-->
            <div class="col-xl-9">
                @foreach(var item in Model.Texts)
                {
                <div class="card">
                    <div class="card-header">
                        <h4 class="oswald text-primary">@item.Title</h4>
                    </div>
                    <div class="row">
                        <div class="col-md-4">
                            <img src="@Url.Content(item.Graphic == null ? "~/img/mini/"+item.CategoryId+".jpg" : "~/img/mini"+item.Graphic)" alt="@item.Category.Name" class="img-fluid" />
                        </div>
                        <div class="col-md-8">
                            <div class="card-body">
                                <h5 class="card-title text-success">@item.User.FullName</h5>
                                <p class="card-text fst-italic">@item.Summary</p>
                                <p class="card-text"><small class="text-muted">Opublikowano: @item.AddedDate</small></p>
                                <div class="position-relative">
                                    <a href="#" class="btn btn-outline-primary position-absolute bottom-0 end-0">Czytaj więcej>>></a>
                                </div>
                            </div>
                        </div>
                    </div>


                </div>
                }
                
            </div>


    </div>

    <!--Stronicowanie-->
    <div class="row mt-3">
        <nav aria-label="Nawigacja pomiędzy kolejnymi stronami">
            <ul class="pagination">
                @{
                    if(Model.TextsView.PageNumber > 1)
                    {
                            <li class="page-item">
                                <a class="page-link" href="@Url.Action("Index", "Texts", new{PageNumber = Model.TextsView.PageNumber - 1})">Poprzednia</a>"
                            </li>
                    }
                    for (var i = 1; i<=Model.TextsView.PageCount; i++)
                    {
                        <li class="@(i == Model.TextsView.PageNumber ? "page-item active" : "page-active")">
                            <a class="page-link" href="@Url.Action("Index", "Texts", new{PageNumber = 1})">@i</a>
                        </li>
                    }
                    if(Model.TextsView.PageNumber < Model.TextsView.PageCount)
                    {
                        <li class="page-item">
                            <a class="page-link" href="@Url.Action("Index", "Texts", new{PageNumber = Model.TextsView.PageNumber + 1})">Następna</a>
                        </li>
                    }
                }
            </ul>
        </nav>
    </div>

</div>
